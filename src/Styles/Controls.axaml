<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="11"/><Setter Property="Height" Value="11"/>
  </Style>
  
  <Style Selector="Border.titlebar">
    <Setter Property="Background" Value="{DynamicResource BgDarkest}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineSoft}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Height" Value="38"/>
  </Style>
  
  <Style Selector="Button.big">
    <Setter Property="Background" Value="{DynamicResource BgModifier}"/>
    <Setter Property="Foreground" Value="{DynamicResource Txt}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="18,10"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="MinWidth" Value="85"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  
  <Style Selector="Button.big:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
  </Style>
  <Style Selector="Button.big.primary">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.big.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentLo}"/>
  </Style>
  
  <Style Selector="Button.mbutton">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="{DynamicResource BgInput}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  
  <Style Selector="Button.mbutton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgInput}"/>
  </Style>
  
  <Style Selector="Button.mbutton:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgInput}"/>
  </Style>
  
  <Style Selector="Button.mbutton Path">
    <Setter Property="Stroke" Value="{DynamicResource Inter}"/>
    <Setter Property="StrokeThickness" Value="2"/>
    <Setter Property="StrokeJoin" Value="Round"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  
  <Style Selector="Button.mbutton Image.set">
    <Setter Property="Source" Value="avares://FH6RB/Assets/icons/icon_arrow.png"/>
  </Style>
  
  <Style Selector="Button.mbutton:pointerover Image.set">
    <Setter Property="Source" Value="avares://FH6RB/Assets/icons/icon_arrow_hover.png"/>
  </Style>
  
  <Style Selector="Button.mbutton Image.loop">
    <Setter Property="Source" Value="avares://FH6RB/Assets/icons/icon_mloop.png"/>
  </Style>
  
  <Style Selector="Button.mbutton:pointerover Image.loop">
    <Setter Property="Source" Value="avares://FH6RB/Assets/icons/icon_mloop_hover.png"/>
  </Style>
  
  <Style Selector="Button.mbutton Image.play">
    <Setter Property="Source" Value="avares://FH6RB/Assets/icons/icon_mplay.png"/>
  </Style>
  
  <Style Selector="Button.mbutton:pointerover Image.play">
    <Setter Property="Source" Value="avares://FH6RB/Assets/icons/icon_mplay_hover.png"/>
  </Style>
  
  <Style Selector="Button.act">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="{DynamicResource BgModifier}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.act:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg1}"/>
  </Style>
  
  <Style Selector="Button.act Path">
    <Setter Property="Stroke" Value="{DynamicResource Inter}"/>
    <Setter Property="StrokeThickness" Value="2"/>
    <Setter Property="StrokeJoin" Value="Round"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  
  <Style Selector="Button.wave_act">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="{DynamicResource BgModifier}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.wave_act:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
  </Style>
  
  <Style Selector="Border.row">
    <Setter Property="Background" Value="{DynamicResource Bg2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Margin" Value="0,0,8,4"/>
  </Style>
  
  <Style Selector="TextBlock.sect">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource TxtFaint}"/>
    <Setter Property="Margin" Value="12,2,0,8"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  
  <Style Selector="TextBox.field">
    <Setter Property="Background" Value="{DynamicResource BgInput}"/>
    <Setter Property="Foreground" Value="{DynamicResource Txt}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BgDarkest}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12 8"/>
    <Setter Property="FontSize" Value="14"></Setter>
  </Style>
  
  <Style Selector="TextBox.field2">
    <Setter Property="Background" Value="{DynamicResource BgInput}"/>
    <Setter Property="Foreground" Value="{DynamicResource Txt}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12 8"/>
    <Setter Property="FontSize" Value="14"></Setter>
  </Style>
  
  <Style Selector="TextBox.field2:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  </Style>
  <Style Selector="TextBox.field2:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  
  <Style Selector="TextBlock.lbl">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource TxtMute}"/>
    <Setter Property="Margin" Value="12,0,0,4"/>
  </Style>
  
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="6"/>
    <Style.Resources>
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#141517"/>
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#141517"/>
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#141517"/>
      <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#141517"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#34363b"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#34363b"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#34363b"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#34363b"/>
      <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#b5bac1"/>
    </Style.Resources>
  </Style>
  
  <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  </Style>
  <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  
  <Style Selector="ToggleButton.adv">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Inter}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="13,11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="ToggleButton.adv:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Header}"/>
  </Style>
  <Style Selector="ToggleButton.adv:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  
  <Style Selector="ScrollBar">
    <Style.Resources>
      <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent"/>
      <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent"/>
      <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent"/>
      <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent"/>
      <SolidColorBrush x:Key="ScrollBarThumbBackgroundColor" Color="#3a3d44"/>
      <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#3a3d44"/>
      <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#5a5f68"/>
      <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#f5356c"/>
      <x:Double x:Key="ScrollBarSize">12</x:Double>
    </Style.Resources>
  </Style>

  <Style Selector="ScrollBar /template/ Grid#Root">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
    <Setter Property="Opacity" Value="0"/>
  </Style>
  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton">
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>

  <Style Selector="ScrollBar:vertical /template/ Thumb">
    <Setter Property="Width" Value="4"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="RenderTransform">
      <TranslateTransform X="-1" Y="0"/>
    </Setter>
  </Style>

  <Style Selector="ScrollBar[IsExpanded=true] /template/ RepeatButton">
    <Setter Property="Opacity" Value="0"/>
  </Style>
  <Style Selector="ScrollBar[IsExpanded=true] /template/ Rectangle#TrackRect">
    <Setter Property="Opacity" Value="0"/>
  </Style>
  <Style Selector="ScrollBar[IsExpanded=true] /template/ Grid#Root">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  
  <Style Selector=":is(Control).spin">
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  
  <Style Selector="Button.big:disabled">
    <Setter Property="Opacity" Value="0.45"/>
  </Style>
  
  <Style Selector="Slider.volume">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  
  <Style Selector="Slider.volume /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
  </Style>

  <Style Selector="Slider.volume /template/ RepeatButton#PART_IncreaseButton">
    <Setter Property="Background" Value="{DynamicResource BgInput}"/>
  </Style>
  
  <Style Selector="Slider.volume /template/ Thumb">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Background" Value="{DynamicResource AccentHi}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Bg1}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  
  <Style Selector="Slider.volume:pointerover /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource AccentHi}"/>
  </Style>

  <Style Selector="Slider.volume:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource AccentHi}"/>
  </Style>
  
  <Style Selector="Slider.volume:pressed /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource AccentLo}"/>
  </Style>

  <Style Selector="Slider.volume:pressed /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource AccentLo}"/>
  </Style>
  
  <Style Selector="Slider.progress">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  
  <Style Selector="Slider.progress /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
  </Style>
  
  <Style Selector="Slider.progress /template/ RepeatButton#PART_IncreaseButton">
    <Setter Property="Background" Value="{DynamicResource BgInput}"/>
  </Style>
  
  <Style Selector="Slider.progress /template/ Thumb">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Background" Value="{DynamicResource AccentHi}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Bg1}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  
  <Style Selector="Slider.progress:pointerover /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource AccentHi}"/>
  </Style>

  <Style Selector="Slider.progress:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource AccentHi}"/>
  </Style>
  
  <Style Selector="Slider.progress:pressed /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource AccentLo}"/>
  </Style>
  
  <Style Selector="Slider.progress:pressed /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource AccentLo}"/>
  </Style>
  
  <Style Selector="Slider.loudness">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  
  <Style Selector="Slider.loudness /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
  </Style>
  
  <Style Selector="Slider.loudness /template/ RepeatButton#PART_IncreaseButton">
    <Setter Property="Background" Value="{DynamicResource BgHoverColor}"/>
  </Style>
  
  <Style Selector="Slider.loudness /template/ Thumb">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Background" Value="{DynamicResource AccentHi}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Bg1}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  
  <Style Selector="Slider.loudness:pointerover /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource AccentHi}"/>
  </Style>

  <Style Selector="Slider.loudness:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource AccentHi}"/>
  </Style>
  
  <Style Selector="Slider.loudness:pressed /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource AccentLo}"/>
  </Style>
  
  <Style Selector="Slider.loudness:pressed /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource AccentLo}"/>
  </Style>
  
  <Style Selector="Slider.loudness:disabled">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>
  <Style Selector="Slider.loudness:disabled /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource TxtMute}"/>
  </Style>

  <Style Selector="CheckBox:disabled">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>

  <Style Selector="ToggleSwitch:disabled">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>

  <Style Selector="ToggleSwitch">
    <Style.Resources>
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#f5356c"/>
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#cf2057"/>
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#cf2057"/>
      <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#f5356c"/>
      <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#f5356c"/>
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#cf2057"/>
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#cf2057"/>
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="#f5356c"/>
    </Style.Resources>
  </Style>

  <Style Selector="Border[IsEnabled=False] TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TxtFaint}"/>
  </Style>

  <Style Selector="CheckBox">
    <Style.Resources>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="White"/>
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="White"/>
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="White"/>
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" Color="White"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminateDisabled" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminateDisabled" Color="#f5356c"/>
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="White"/>
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" Color="White"/>
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" Color="White"/>
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminateDisabled" Color="White"/>
    </Style.Resources>
  </Style>
  
  <Style Selector="ComboBox /template/ Popup#PART_Popup">
    <Setter Property="Placement" Value="AnchorAndGravity"/>
    <Setter Property="PlacementAnchor" Value="BottomRight"/>
    <Setter Property="PlacementGravity" Value="BottomLeft"/>
    <Setter Property="VerticalOffset" Value="4"/>
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Cursor" Value="Arrow"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBoxItem:pressed">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBoxItem:selectedunfocused">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBoxItem:selectedunfocused /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
</Styles>
