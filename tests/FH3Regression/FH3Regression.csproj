<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FH6RB.csproj" />
    <None Include="../../tools/ffmpeg/ffmpeg.exe;../../tools/ffmpeg/ffprobe.exe" Link="ffmpeg/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tools/fsbank/*" Link="fsbank/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tools/vgmstream/*" Link="vgmstream/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
